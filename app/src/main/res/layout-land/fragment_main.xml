<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/contentCoordinatorLayout"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp">

            <!-- The mark of the app: a note in a Material shape -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/brandShapeImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_music_note"
                    app:tint="?attr/colorOnPrimaryContainer" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greetingTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
                    android:textColor="?attr/colorPrimary"
                    tools:text="Good evening" />

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:contentInsetStart="0dp"
                    app:titleMarginStart="0dp"
                    app:titleTextAppearance="@style/TextAppearance.Twelve.HeaderTitle"
                    app:titleTextColor="?attr/colorOnSurface"
                    tools:title="@string/app_name" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/providerMaterialButton"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:maxWidth="140dp"
                tools:icon="@drawable/ic_shelves"
                tools:text="Pixel 7 Pro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refreshMaterialButton"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/refresh"
                android:tooltipText="@string/refresh"
                android:visibility="gone"
                app:icon="@drawable/ic_sync" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importMaterialButton"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/import_playlist"
                android:tooltipText="@string/import_playlist"
                android:visibility="gone"
                app:icon="@drawable/ic_playlist_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsMaterialButton"
                style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/title_activity_settings"
                android:tooltipText="@string/title_activity_settings"
                app:icon="@drawable/ic_settings" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggleGroup"
            style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/mode_switch_description"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/offlineModeButton"
                style="@style/Widget.Twelve.ConnectedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/mode_offline"
                app:icon="@drawable/ic_smartphone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onlineModeButton"
                style="@style/Widget.Twelve.ConnectedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/mode_online"
                app:icon="@drawable/ic_cloud" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/contentCoordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/navigationBarView"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager2"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playRandomSongsButton"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/play_random_songs"
            android:text="@string/play_random_songs"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:tooltipText="@string/play_random_songs"
            app:backgroundTint="?attr/colorTertiaryContainer"
            app:icon="@drawable/ic_shuffle_play"
            app:iconTint="?attr/colorOnTertiaryContainer"
            app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navigationBarView"
        style="@style/Widget.Material3Expressive.NavigationRailView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/navigation_bar_view_fragment_main"
        app:menuGravity="center"
        app:paddingBottomSystemWindowInsets="false"
        app:paddingTopSystemWindowInsets="false" />

    <include
        layout="@layout/main_search_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
