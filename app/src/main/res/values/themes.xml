<resources>
    <!-- Application theme -->
    <style name="Theme.Twelve" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="materialSwitchStyle">@style/Widget.SettingsLib.MaterialSwitch</item>

        <!-- Material 3 Expressive: rounder shapes and wavy progress indicators -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Twelve.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Twelve.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Twelve.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Twelve.Corner.ExtraLarge</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy</item>
    </style>

    <style name="ShapeAppearance.Twelve.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Twelve.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Twelve.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Twelve.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">36dp</item>
    </style>

    <!--
         Glass look used by the screens drawn over the blurred artwork: translucent white
         containers and white content, independent of the wallpaper colors.
    -->
    <style name="ThemeOverlay.Twelve.Player" parent="ThemeOverlay.Material3Expressive.Dark">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#1B1B1F</item>
        <item name="colorPrimaryContainer">#38FFFFFF</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSecondary">#E6FFFFFF</item>
        <item name="colorOnSecondary">#1B1B1F</item>
        <item name="colorSecondaryContainer">#2EFFFFFF</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">#FFFFFF</item>
        <item name="colorOnTertiary">#1B1B1F</item>
        <item name="colorTertiaryContainer">#40FFFFFF</item>
        <item name="colorOnTertiaryContainer">#FFFFFF</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B8FFFFFF</item>
        <item name="colorSurfaceContainerHighest">#2EFFFFFF</item>
        <item name="colorSurfaceContainerHigh">#26FFFFFF</item>
        <item name="colorSurfaceContainer">#1FFFFFFF</item>
        <item name="colorOutline">#66FFFFFF</item>
        <item name="colorOutlineVariant">#33FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B8FFFFFF</item>
    </style>

    <!-- Full-width cover whose bottom corners are rounded -->
    <style name="ShapeAppearanceOverlay.Twelve.CoverHero" parent="">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">44dp</item>
        <item name="cornerSizeBottomRight">44dp</item>
    </style>

    <!-- Base dialog theme -->
    <style name="BaseTheme.Twelve.Dialog" parent="Theme.Material3Expressive.Light.Dialog.Alert" />

    <!-- Dialog theme -->
    <style name="Theme.Twelve.Dialog" parent="BaseTheme.Twelve.Dialog">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="materialSwitchStyle">@style/Widget.SettingsLib.MaterialSwitch</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- No elements styles -->
    <style name="Theme.Twelve.NoElements" />

    <style name="Theme.Twelve.NoElements.LinearLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Theme.Twelve.NoElements.ImageView">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="tint">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.Twelve.NoElements.Space">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">8dp</item>
    </style>

    <style name="Theme.Twelve.NoElements.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Now playing fragment -->
    <style name="Theme.Twelve.NowPlayingFragment.MediaButton.Primary" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">36dp</item>
    </style>

    <style name="Theme.Twelve.NowPlayingFragment.MediaButton.Tertiary" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
        <item name="iconTint">?attr/colorOnTertiaryContainer</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">36dp</item>
        <item name="materialSizeOverlay">
            @style/SizeOverlay.Material3Expressive.Button.IconButton.Small.Narrow
        </item>
    </style>

    <style name="Theme.Twelve.NowPlayingFragment.MediaButton.Standard" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="Theme.Twelve.NowPlayingFragment.MediaButton.Tertiary.Container" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
    </style>

    <style name="Theme.Twelve.NowPlayingFragment.MediaButton.Tertiary.Marker" parent="">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_gravity">bottom|center_horizontal</item>
        <item name="android:src">@drawable/now_playing_marker</item>
        <item name="android:visibility">gone</item>
        <item name="tint">?attr/colorPrimary</item>
    </style>

    <style name="Theme.Twelve.NowPlayingFragment.BottomBarButton" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="backgroundTint">@color/now_playing_bottom_button_background</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="TextAppearance.Twelve.HeaderTitle" parent="TextAppearance.Material3.HeadlineLarge.Emphasized">
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- A button of a connected group: the chosen one fills with the accent color and becomes a pill -->
    <style name="Widget.Twelve.ConnectedButton" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:checkable">true</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="backgroundTint">@color/mode_toggle_background</item>
        <item name="android:textColor">@color/mode_toggle_foreground</item>
        <item name="iconTint">@color/mode_toggle_foreground</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- A search filter: a pill that fills with the accent color when chosen -->
    <style name="Widget.Twelve.SearchFilterButton" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:checkable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="backgroundTint">@color/mode_toggle_background</item>
        <item name="android:textColor">@color/mode_toggle_foreground</item>
    </style>

    <!-- App widget -->
    <style name="Theme.Twelve.AppWidgetContainer" parent="Theme.Material3Expressive.DynamicColors.DayNight">
        <item name="appWidgetRadius">36dp</item>
    </style>
</resources>
