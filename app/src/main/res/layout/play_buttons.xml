<com.google.android.material.button.MaterialButtonGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playButtonsLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playAllButton"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/play_all"
        android:tooltipText="@string/play_all"
        app:icon="@drawable/ic_play_arrow"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLargeEmphasized" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shufflePlayButton"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/shuffle_play"
        android:tooltipText="@string/shuffle_play"
        app:icon="@drawable/ic_shuffle_play"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLargeEmphasized" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playNextButton"
        style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="@string/audio_play_next"
        android:tooltipText="@string/audio_play_next"
        app:icon="@drawable/ic_queue_play_next"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addToQueue"
        style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="@string/audio_add_to_queue"
        android:tooltipText="@string/audio_add_to_queue"
        app:icon="@drawable/ic_add_to_queue"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

</com.google.android.material.button.MaterialButtonGroup>
