<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_widget"
    android:backgroundTint="?attr/colorPrimary"
    android:clipToOutline="true"
    android:theme="@style/Theme.Twelve.AppWidgetContainer"
    tools:targetApi="s">

    <!-- The cover, slightly blurred, fills the widget -->
    <ImageView
        android:id="@+id/backdropImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Darkens it so that text and buttons can be read on any cover -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/thumbnailImageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_widget_cover"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:clipToOutline="true"
            android:contentDescription="@string/content_description_thumbnail"
            android:maxHeight="170dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            tools:targetApi="s" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/now_playing_widget_dummy_title"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artistNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/now_playing_widget_dummy_artist"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previousImageButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_widget_round"
                android:backgroundTint="#40FFFFFF"
                android:contentDescription="@string/content_description_previous_track"
                android:scaleType="center"
                android:src="@drawable/ic_skip_previous"
                android:tint="@android:color/white"
                tools:ignore="UseAppTint"
                tools:targetApi="s" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/bufferingProgressBar"
                    style="@style/Widget.AppCompat.ProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/playPauseImageButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_widget_pill_big"
                    android:backgroundTint="?attr/colorPrimary"
                    android:contentDescription="@string/content_description_play_pause"
                    android:scaleType="center"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="?attr/colorOnPrimary"
                    tools:ignore="UseAppTint"
                    tools:targetApi="s" />

            </FrameLayout>

            <ImageButton
                android:id="@+id/nextImageButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_widget_round"
                android:backgroundTint="#40FFFFFF"
                android:contentDescription="@string/content_description_next_track"
                android:scaleType="center"
                android:src="@drawable/ic_skip_next"
                android:tint="@android:color/white"
                tools:ignore="UseAppTint"
                tools:targetApi="s" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
