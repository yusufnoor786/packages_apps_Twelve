<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <org.lineageos.twelve.ui.expressive.ShapeMaskLayout
        android:id="@+id/shapeMaskLayout"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_marginBottom="10dp"
        app:maskShape="cookie_9">

        <ImageView
            android:id="@+id/placeholderImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorTertiary"
            android:contentDescription="@string/content_description_thumbnail"
            android:padding="32dp"
            android:visibility="gone"
            app:tint="?attr/colorOnTertiary"
            tools:src="@drawable/ic_person"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/thumbnailImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/content_description_thumbnail"
            android:scaleType="centerCrop" />

    </org.lineageos.twelve.ui.expressive.ShapeMaskLayout>

    <TextView
        android:id="@+id/headlineTextView"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmallEmphasized"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:visibility="gone"
        tools:text="Headline"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/subheadTextView"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:alpha="0.75"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:visibility="gone"
        tools:text="Subhead"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/supportingTextView"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:visibility="gone"
        tools:text="Supporting"
        tools:visibility="visible" />

</LinearLayout>
