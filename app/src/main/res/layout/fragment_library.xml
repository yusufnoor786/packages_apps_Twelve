<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/menuToggleGroup"
        style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/albumsButton"
                style="@style/Widget.Twelve.ConnectedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/library_fragment_menu_albums" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/artistsButton"
                style="@style/Widget.Twelve.ConnectedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/library_fragment_menu_artists" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/genresButton"
                style="@style/Widget.Twelve.ConnectedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/library_fragment_menu_genres" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playlistsButton"
                style="@style/Widget.Twelve.ConnectedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/library_fragment_menu_playlists" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
