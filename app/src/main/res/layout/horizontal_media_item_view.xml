<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_media_card"
    android:orientation="vertical"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp">

        <ImageView
            android:id="@+id/placeholderImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorPrimaryContainer"
            android:contentDescription="@string/content_description_thumbnail"
            android:padding="32dp"
            android:visibility="gone"
            app:tint="?attr/colorOnPrimaryContainer"
            tools:src="@drawable/ic_person"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/thumbnailImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/content_description_thumbnail"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/headlineTextView"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:hyphenationFrequency="normal"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Headline"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/subheadTextView"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:hyphenationFrequency="normal"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Subhead"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/supportingTextView"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:hyphenationFrequency="normal"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Supporting"
        tools:visibility="visible" />

</LinearLayout>
