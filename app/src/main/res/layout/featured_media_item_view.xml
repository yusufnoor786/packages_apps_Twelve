<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/placeholderImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorPrimary"
            android:contentDescription="@string/content_description_thumbnail"
            android:padding="36dp"
            android:visibility="gone"
            app:tint="?attr/colorOnPrimary"
            tools:src="@drawable/ic_album"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/thumbnailImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/content_description_thumbnail"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/headlineTextView"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:visibility="gone"
        tools:text="Headline"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/subheadTextView"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:alpha="0.75"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:visibility="gone"
        tools:text="Subhead"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/supportingTextView"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:visibility="gone"
        tools:text="Supporting"
        tools:visibility="visible" />

</LinearLayout>
