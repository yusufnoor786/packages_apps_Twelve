<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lyricsToggleMaterialButton"
        style="@style/Theme.Twelve.NowPlayingFragment.BottomBarButton"
        android:layout_marginHorizontal="20dp"
        android:checkable="true"
        android:contentDescription="@string/lyrics"
        android:tooltipText="@string/lyrics"
        android:visibility="gone"
        app:icon="@drawable/ic_lyrics"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/isFavoriteMaterialButton"
        style="@style/Theme.Twelve.NowPlayingFragment.BottomBarButton"
        android:layout_marginHorizontal="20dp"
        android:tooltipText="@string/add_to_favorites"
        android:visibility="gone"
        app:icon="@drawable/ic_heart_unfilled" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/queueMaterialButton"
        style="@style/Theme.Twelve.NowPlayingFragment.BottomBarButton"
        android:layout_marginHorizontal="20dp"
        android:checkable="true"
        android:contentDescription="@string/queue"
        android:tooltipText="@string/queue"
        app:icon="@drawable/ic_queue_play_next" />

</LinearLayout>
